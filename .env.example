# Sifdine Bot Configuration
# Copy this file to .env and fill in your credentials

# Bot Environment: 'prod' or 'dev'
ENVIRONMENT=prod

# Required Credentials
DISCORD_TOKEN=your_discord_bot_token_here

# Optional API Keys (Only provide what you use)
IMAGE_KEY=your_image_api_key_here
WEATHER_KEY=your_weather_api_key_here
SERPAPI_KEY=your_serpapi_key_here
OCR_KEY=your_ocr_space_api_key_here_or_helloworld
RAPID_API_KEY_1=your_rapid_api_key_1_here 
RAPID_API_KEY_2=your_rapid_api_key_2_here # 2 Keys for load balancing
STEAM_API_KEY=your_steam_api_key_here
REDDIT_BOT_TOKEN=your_reddit_app_token_here

# Channel IDs (Optional for specific functionality)
SUGGESTIONS_CHANNEL_ID=0
BUGS_CHANNEL_ID=0
BACKUP_CHANNEL_ID=0